              </a>
            </li>
          </ul>
        )}
        <a class="go" href="https://www.youtube.com/@dorulian" target="_blank" rel="noopener">Urmărește pe YouTube →</a>
      </div>

      <div class="channel reveal">
        <div class="channel-top"><span class="stamp">Activ</span></div>
        <h3>Poze / Pixelfed</h3>
        {latestPixelfed && (
          <ul class="latest-posts">
            <li>
              <a class="post-link" href={latestPixelfed.link} target="_blank" rel="noopener">
                {latestPixelfed.image && <span class="post-thumb" style={`background-image:url('${latestPixelfed.image}')`}></span>}
                <span class="post-text">{latestPixelfed.title}</span>
              </a>
            </li>
          </ul>
        )}
        <a class="go" href="https://pixelfed.social/dorulians" target="_blank" rel="noopener">Urmărește pe Pixelfed →</a>
      </div>

      <div class="channel reveal">
        <div class="channel-top"><span class="stamp">Activ</span></div>
        <h3>Articole / Din culise</h3>
        {latestPost && (
          <ul class="latest-posts">
            <li>
              <a class="post-link" href={latestPost.link} target="_blank" rel="noopener">
