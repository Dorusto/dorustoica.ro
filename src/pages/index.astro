---
import '../styles/global.css';
---

<!doctype html>
<html lang="ro">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Doru Stoica — #DEPPSiT</title>
  <meta name="description" content="Creator de conținut despre suveranitate digitală, self-hosting și AI local. Dacă eu pot, poți și tu." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="bg-[#0a0a0f] text-white min-h-screen flex flex-col items-center justify-center px-6 py-16 font-sans">

  <main class="w-full max-w-md flex flex-col items-center text-center gap-8">

    <!-- Avatar -->
    <img
      src="/doru.jpg"
      alt="Doru Stoica"
      class="w-32 h-32 rounded-full object-cover object-top shadow-lg shadow-emerald-500/20 border-2 border-emerald-500/30"
    />

    <!-- Nume + tagline -->
    <div class="flex flex-col gap-2">
      <h1 class="text-4xl font-bold tracking-tight">Doru Stoica</h1>
      <p class="text-emerald-400 font-medium tracking-wide text-sm uppercase">#DEPPSiT — Dacă eu pot, poți și tu</p>
    </div>

    <!-- Bio -->
    <p class="text-gray-400 leading-relaxed">
      De la electrician naval la electrical engineer și acum software engineer.
      De la pasiunea pentru fotografie și film la creator de conținut.
    </p>
    <p class="text-gray-400 leading-relaxed">
      În timpul liber, construiesc un asistent personal numit <span class="text-white font-semibold">Majordom</span> care lucrează pentru mine, nu pentru corporații.
    </p>

    <!-- Butoane -->
    <div class="flex flex-col sm:flex-row gap-3 w-full justify-center">
      <a
        href="https://majordom.dorustoica.ro"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-emerald-500/40 bg-emerald-500/10 text-emerald-400 hover:bg-emerald-500/20 hover:border-emerald-500/60 transition-all duration-300 font-medium text-sm"
      >
        🏛️ Descoperă Majordom
      </a>
      <a
        href="https://cal.com/dorulian"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full border border-white/20 bg-white/5 text-gray-300 hover:bg-white/10 hover:border-white/40 transition-all duration-300 font-medium text-sm"
      >
        📅 Rezervă o sesiune
      </a>
    </div>

    <!-- Substack -->
    <div class="w-full rounded-2xl border border-white/10 bg-white/5 p-2">
      <iframe
        src="https://dorulian.substack.com/embed"
        width="100%"
        height="180"
        style="border:none; background:transparent !important;"
        frameborder="0"
        scrolling="no"
      ></iframe>
    </div>

    <!-- Social links -->
    <div class="flex gap-6 text-sm text-gray-500">
      <a href="https://www.youtube.com/@dorulian" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">YouTube</a>
      <a href="https://github.com/Dorusto" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GitHub</a>
      <a href="https://dorulian.substack.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Substack</a>
      <a href="https://ko-fi.com/dorulian" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">Ko-fi</a>
    </div>

  </main>

  <footer class="mt-16 text-gray-600 text-xs">
    © 2026 Doru Stoica
  </footer>

</body>
</html>
