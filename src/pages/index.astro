    </div>
  </section>

  <section class="proof reveal">
    <div class="proof-stats">
      <div class="proof-stat"><span class="proof-num">03</span><span class="proof-label">proiecte active</span></div>
      <div class="proof-stat"><span class="proof-num">05</span><span class="proof-label">canale publice</span></div>
