---
import '../styles/global.css';

let umamiStats: { yesterday: number; last30: number } | null = null;
const UMAMI_API_KEY = import.meta.env.UMAMI_API_KEY;
if (UMAMI_API_KEY) {
  try {
    const websiteId = '977ce415-76bd-465e-8dfb-f627cf92f951';
    const headers = { Authorization: `Bearer ${UMAMI_API_KEY}` };
    const now = Date.now();
    const startOfToday = new Date().setUTCHours(0, 0, 0, 0);
    const startOfYesterday = startOfToday - 24 * 60 * 60 * 1000;

    const yesterdayRes = await fetch(
      `https://api.umami.is/v1/websites/${websiteId}/stats?startAt=${startOfYesterday}&endAt=${startOfToday}`,
      { headers }
    ).then(r => r.json());
    const last30Res = await fetch(
      `https://api.umami.is/v1/websites/${websiteId}/stats?startAt=${now - 30 * 24 * 60 * 60 * 1000}&endAt=${now}`,
      { headers }
    ).then(r => r.json());

    if (typeof yesterdayRes.visitors === 'number' && typeof last30Res.visitors === 'number') {
      umamiStats = { yesterday: yesterdayRes.visitors, last30: last30Res.visitors };
    }
  } catch (e) {
    // Build shouldn't fail if Umami is briefly unreachable or the key is missing/invalid.
  }
}

let latestPost: { title: string; link: string; image?: string } | null = null;
try {
  const res = await fetch('https://dorulian.substack.com/feed');
  const xml = await res.text();
  const firstItem = xml.match(/<item>([\s\S]*?)<\/item>/)?.[1];
  if (firstItem) {
    const title = firstItem.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/)?.[1];
    const link = firstItem.match(/<link>(.*?)<\/link>/)?.[1];
    const image = firstItem.match(/<enclosure url="([^"]+)"/)?.[1];
    if (title && link) latestPost = { title, link, image };
  }
} catch (e) {
  // Build shouldn't fail just because Substack is briefly unreachable.
}

let latestYouTube: { title: string; link: string; image?: string } | null = null;
try {
  const res = await fetch('https://www.youtube.com/feeds/videos.xml?channel_id=UCWinPMNiK6ExhVjm0Ighiew');
  const xml = await res.text();
  const firstEntry = xml.match(/<entry>([\s\S]*?)<\/entry>/)?.[1];
  if (firstEntry) {
    const title = firstEntry.match(/<title>(.*?)<\/title>/)?.[1];
    const link = firstEntry.match(/<link rel="alternate" href="([^"]+)"/)?.[1];
    const image = firstEntry.match(/<media:thumbnail url="([^"]+)"/)?.[1];
    if (title && link) latestYouTube = { title, link, image };
  }
} catch (e) {
  // Build shouldn't fail just because YouTube is briefly unreachable.
}

let latestPixelfed: { link: string; image?: string; title: string } | null = null;
try {
  const res = await fetch('https://pixelfed.social/users/dorulians.atom');
  const xml = await res.text();
  const firstEntry = xml.match(/<entry>([\s\S]*?)<\/entry>/)?.[1];
  if (firstEntry) {
    const link = firstEntry.match(/<link rel="alternate" href="([^"]+)"/)?.[1];
    const image = firstEntry.match(/<media:content\s+url="([^"]+)"/)?.[1];
    const rawTitle = firstEntry.match(/<title>([\s\S]*?)<\/title>/)?.[1]?.trim();
    const title = (rawTitle && rawTitle !== 'No caption') ? rawTitle : 'Poză nouă pe Pixelfed';
    if (link) latestPixelfed = { link, image, title };
  }
} catch (e) {
  // Build shouldn't fail just because Pixelfed is briefly unreachable.
}
