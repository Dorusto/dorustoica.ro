              <a class="post-link" href={latestPost.link} target="_blank" rel="noopener">
                {latestPost.image && <span class="post-thumb" style={`background-image:url('${latestPost.image}')`}></span>}
                <span class="post-text">{latestPost.title}</span>
              </a>
            </li>
          </ul>
        )}
        <a class="go" href="https://dorulian.substack.com" target="_blank" rel="noopener">Citește pe Substack →</a>
      </div>

      <div class="channel reveal">
        <div class="channel-top"><span class="stamp">Activ</span></div>
        <span class="tag">Microblog / Mastodon</span>
        <h3>Semnal</h3>
        <ul class="latest-posts" data-mastodon-latest></ul>
        <a class="go" href="https://mastodon.social/@dorulian" target="_blank" rel="noopener">Vezi tot pe Mastodon →</a>
      </div>

      <a href="https://t.me/viatacudoru" class="channel reveal" target="_blank" rel="noopener">
        <div class="channel-top"><span class="stamp">Activ</span></div>
        <span class="tag">Chat direct / Telegram</span>
        <h3>Telegram</h3>
        <p>Locul unde poți vorbi direct cu mine: întrebări, idei, feedback.</p>
        <span class="go">Intră în chat →</span>
      </a>

      <div class="channel disabled reveal" aria-disabled="true">
        <div class="channel-top"><span class="stamp pending">În lucru</span></div>
        <span class="tag">Video / PeerTube</span>
        <h3>Arhivă</h3>
        <p>Arhivă video self-hosted pe NAS propriu, în lucru.</p>
        <span class="go">Urmează</span>
      </div>

    </div>
  </section>

  <section class="utility reveal" id="contact">
    <div class="dim-divider reveal"><span class="tick"></span><span class="line"></span><span class="label">Contact</span><span class="line"></span><span class="tick"></span></div>
    <div class="util-links">
      <a href="mailto:dorulian.work@gmail.com">Scrie-mi: dorulian.work@gmail.com</a>
      <a href="https://github.com/Dorusto" target="_blank" rel="noopener">GitHub</a>
      <a href="https://cal.com/dorulian" target="_blank" rel="noopener" class="highlight">Rezervă consultanță 1-la-1</a>
      <a href="https://ko-fi.com/dorulian" target="_blank" rel="noopener">Susține-mă pe Ko-fi</a>
    </div>
  </section>

  <footer>
    <div class="subscribe-box reveal">
      <div class="embed-frame">
        <iframe src="https://dorulian.substack.com/embed" width="100%" height="160" style="border:none; background:transparent;" frameborder="0" scrolling="no" loading="lazy" title="Newsletter din culise"></iframe>
      </div>
    </div>
    <div class="foot-row">
      <span class="mono">© 2026 Doru Stoica</span>
    </div>
  </footer>

</main>

<script is:inline>
  const reveals = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting){
        setTimeout(() => entry.target.classList.add('is-visible'), i * 50);
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  reveals.forEach(el => io.observe(el));

  // Live "latest posts" — only Mastodon's public API is CORS-friendly enough
  // for a plain static page. YouTube/Pixelfed/Substack need a build-time fetch
  // or a self-hosted proxy; faking their previews here would just go stale.
  (async () => {
    const list = document.querySelector('[data-mastodon-latest]');
    if (!list) return;
    try {
      const account = await fetch('https://mastodon.social/api/v1/accounts/lookup?acct=dorulian').then(r => r.json());
      const statuses = await fetch(`https://mastodon.social/api/v1/accounts/${account.id}/statuses?limit=1&exclude_replies=true&exclude_reblogs=true`).then(r => r.json());
      list.innerHTML = statuses.slice(0, 1).map(s => {
        const text = s.content.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
        const short = text.length > 200 ? text.slice(0, 200) + '…' : text;
        const image = (s.media_attachments || []).find(m => m.type === 'image');
        const thumb = image ? `<span class="post-thumb" style="background-image:url('${image.preview_url}')"></span>` : '';
        const textSpan = short ? `<span class="post-text">${short}</span>` : '';
        return `<li><a class="post-link" href="${s.url}" target="_blank" rel="noopener">${thumb}${textSpan}</a></li>`;
      }).join('');
    } catch (e){
      // Silent — the static description above already covers this card.
    }
  })();

  const gridBg = document.getElementById('gridBg');
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking){
      requestAnimationFrame(() => {
        gridBg.style.transform = `translateY(${window.scrollY * 0.04}px)`;
        ticking = false;
      });
      ticking = true;
    }
  });
</script>

</body>
</html>
