  <section class="majordom-section" id="laborator">
    <div class="dim-divider reveal"><span class="tick"></span><span class="line"></span><span class="label">Laborator</span><span class="line"></span><span class="tick"></span></div>
    <a href="https://github.com/Dorusto/life-os" class="feature reveal" target="_blank" rel="noopener">
      <div class="feature-left">
        <div class="channel-top"><span class="stamp pending">În lucru</span></div>
        <span class="feature-title">Asistent AI / Majordom</span>
        <p>Construiesc stratul conversațional AI local peste sistemele mele.</p>
      </div>
      <span class="go">Vezi pe GitHub →</span>
    </a>

    <div class="lab-grid">
      <a href="https://www.etsy.com/shop/DEPPSiTStore" class="lab-tile reveal" target="_blank" rel="noopener">
        <div class="channel-top"><span class="stamp">Activ</span></div>
        <h4>AI T-Shirt Studio / Side Project</h4>
        <p>Portrete AI personalizate, generate cu ComfyUI + PuLID Flux. Susține ce fac cumpărând un tricou personalizat de pe DEPPSiTStore.</p>
        <span class="go">Vezi DEPPSiTStore →</span>
      </a>
      <a href="https://github.com/Dorusto/yt-pipeline" class="lab-tile reveal" target="_blank" rel="noopener">
        <div class="channel-top"><span class="stamp pending">În lucru</span></div>
        <h4>Automatizare / yt-pipeline</h4>
        <p>Asistentul meu care mă ajută cu transcrieri, traduceri, generare Shorts.</p>
        <span class="go">Vezi pe GitHub →</span>
      </a>
    </div>
  </section>

  <section class="board" id="canale">
    <div class="dim-divider reveal"><span class="tick"></span><span class="line"></span><span class="label">Canale</span><span class="line"></span><span class="tick"></span></div>

    <div class="channels">

      <div class="channel reveal">
        <div class="channel-top"><span class="stamp">Activ</span></div>
        <h3>Video / YouTube</h3>
        {latestYouTube && (
          <ul class="latest-posts">
            <li>
              <a class="post-link" href={latestYouTube.link} target="_blank" rel="noopener">
