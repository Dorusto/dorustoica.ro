---
import '../styles/global.css';

let latestPost: { title: string; link: string; image?: string } | null = null;
try {
  const res = await fetch('https://dorulian.substack.com/feed');
  const xml = await res.text();
  const firstItem = xml.match(/<item>([\s\S]*?)<\/item>/)?.[1];
  if (firstItem) {
    const title = firstItem.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/)?.[1];
    const link = firstItem.match(/<link>(.*?)<\/link>/)?.[1];
    const image = firstItem.match(/<enclosure url="([^"]+)"/)?.[1];
    if (title && link) latestPost = { title, link, image };
  }
} catch (e) {
  // Build shouldn't fail just because Substack is briefly unreachable.
}

let latestYouTube: { title: string; link: string; image?: string } | null = null;
try {
  const res = await fetch('https://www.youtube.com/feeds/videos.xml?channel_id=UCWinPMNiK6ExhVjm0Ighiew');
  const xml = await res.text();
  const firstEntry = xml.match(/<entry>([\s\S]*?)<\/entry>/)?.[1];
  if (firstEntry) {
    const title = firstEntry.match(/<title>(.*?)<\/title>/)?.[1];
    const link = firstEntry.match(/<link rel="alternate" href="([^"]+)"/)?.[1];
    const image = firstEntry.match(/<media:thumbnail url="([^"]+)"/)?.[1];
    if (title && link) latestYouTube = { title, link, image };
  }
} catch (e) {
  // Build shouldn't fail just because YouTube is briefly unreachable.
}

let latestPixelfed: { link: string; image?: string } | null = null;
try {
  const res = await fetch('https://pixelfed.social/users/dorulians.atom');
  const xml = await res.text();
  const firstEntry = xml.match(/<entry>([\s\S]*?)<\/entry>/)?.[1];
  if (firstEntry) {
    const link = firstEntry.match(/<link rel="alternate" href="([^"]+)"/)?.[1];
    const image = firstEntry.match(/<media:content\s+url="([^"]+)"/)?.[1];
    if (link) latestPixelfed = { link, image };
  }
} catch (e) {
  // Build shouldn't fail just because Pixelfed is briefly unreachable.
}
